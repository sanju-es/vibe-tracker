{
  "name": "project-tracking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build && npm run dist:check",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dist:check": "node scripts/dist-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "node scripts/docs-audit.mjs",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,svelte,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,json,html}\"",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,json,html}\""
  },
  "dependencies": {
    "marked": "^18.2.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.1.0"
  }
}
